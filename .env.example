# Copy to .env for local reference. ReverserX does not automatically load .env;
# export variables in your shell or use a trusted environment manager.
REVERSERX_DATA_DIR=.reverserx
REVERSERX_LOG_LEVEL=INFO
REVERSERX_MAX_AGENT_INPUT_TOKENS=500000
REVERSERX_MAX_AGENT_OUTPUT_TOKENS=100000
REVERSERX_MAX_AGENT_WALL_TIME_SECONDS=3600
REVERSERX_MAX_TOOL_DURATION_SECONDS=900
REVERSERX_MODEL_OUTPUT_TOKENS_PER_CALL=4096
REVERSERX_OPENAI_MODEL=gpt-5.6-sol
REVERSERX_OPENAI_INPUT_COST_PER_MILLION=5.0
REVERSERX_OPENAI_OUTPUT_COST_PER_MILLION=30.0
REVERSERX_OPENAI_IMAGE_COST_PER_MILLION=5.0
REVERSERX_OLLAMA_MODEL=gpt-oss:20b
REVERSERX_OLLAMA_IMAGE_SUPPORT=false

# Optional providers. Never commit real values.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
